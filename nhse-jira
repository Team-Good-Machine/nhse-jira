DEFAULT_CONFIG_PATH = Path.home() / ".config" / "nhse-jira" / "config.yml"
DEFAULT_NETRC_PATH = Path.home() / ".netrc"


class FieldConfig(TypedDict):
    field: str
    format: NotRequired[str]


class CustomFieldsConfig(TypedDict, total=False):
    metadata: dict[str, FieldConfig]
    sections: dict[str, FieldConfig]


class Config(TypedDict):
    server: str
    project: str
    epic_field: NotRequired[str]
    custom_fields: NotRequired[CustomFieldsConfig]


def load_config(config_path: Path | str = DEFAULT_CONFIG_PATH) -> Config:
    config_path = Path(config_path)
    if not config_path.exists():
        print(f"Error: Config file not found: {config_path}", file=sys.stderr)
        raise SystemExit(f"Config file not found: {config_path}")
    return cast(Config, yaml.safe_load(config_path.read_text()))


def load_token(server_url: str, netrc_path: Path | str = DEFAULT_NETRC_PATH) -> str:
    hostname = urlparse(server_url).hostname
    if hostname is None:
        raise SystemExit(f"Invalid server URL (no hostname): {server_url}")
    try:
        nrc = netrc_mod.netrc(str(netrc_path))
    except FileNotFoundError:
        print(
            f"Error: No .netrc file found at {netrc_path}\n"
            "Create a Personal Access Token in Jira and add it:\n"
            f"  machine {hostname} login _ password <your-token>",
            file=sys.stderr,
        )
        raise SystemExit(f"No .netrc entry for {hostname}")
    auth = nrc.authenticators(hostname)
    if auth is None:
        print(
            f"Error: No .netrc entry for {hostname}\n"
            "Add this line to your ~/.netrc:\n"
            f"  machine {hostname} login _ password <your-token>",
            file=sys.stderr,
        )
        raise SystemExit(f"No .netrc entry for {hostname}")
    return auth[2]


def normalize_key(key: str, default_project: str) -> str:
    if key.isdigit():
        return f"{default_project}-{key}"
    return key.upper()


def normalize_jql(jql: str, default_project: str) -> str:
    if not re.search(r"\bproject\s*=", jql, re.IGNORECASE):
        return f"project = {default_project} AND {jql}"
    return jql


type FieldSpec = tuple[str, str, str]  # (label, field_id, format)

STANDARD_FIELDS: dict[str, FieldSpec] = {
    "assignee": ("Assignee", "assignee", "user"),
    "reporter": ("Reporter", "reporter", "user"),
    "resolution": ("Resolution", "resolution", "resolution"),
    "updated": ("Updated", "updated", "date"),
    "created": ("Created", "created", "date"),
    "parent": ("Parent", "parent", "issue_key"),
}


def resolve_fields(
    field_names: list[str] | None,
    custom_fields: CustomFieldsConfig,
    epic_field: str | None = None,
) -> list[FieldSpec]:
    if not field_names:
        return []
    # Build lookup from standard fields + custom fields (metadata + sections)
    lookup: dict[str, FieldSpec] = dict(STANDARD_FIELDS)
    if epic_field:
        lookup["epic link"] = ("Epic Link", epic_field, "string")
    for section_dict in (custom_fields.get("metadata"), custom_fields.get("sections")):
        if section_dict:
            for label, cfg in section_dict.items():
                lookup[label.lower()] = (label, cfg["field"], cfg.get("format", "string"))
    result: list[FieldSpec] = []
    for name in field_names:
        key = name.strip().lower()
        if key not in lookup:
            print(f"Error: Unknown field '{name}'", file=sys.stderr)
            raise SystemExit(f"Unknown field: {name}")
        result.append(lookup[key])
    return result


@dataclass(frozen=True)
class Colors:
    bold: str = ""
    reset: str = ""
    cyan: str = ""
    green: str = ""
    yellow: str = ""
    red: str = ""
    blue: str = ""
    magenta: str = ""

    @classmethod
    def enabled(cls) -> "Colors":
        return cls(
            bold="\033[1m",
            reset="\033[0m",
            cyan="\033[36m",
            green="\033[32m",
            yellow="\033[33m",
            red="\033[31m",
            blue="\033[34m",
            magenta="\033[35m",
        )

    @classmethod
    def disabled(cls) -> "Colors":
        return cls()

    def issue_type(self, issue_type: str) -> str:
        return {"Story": self.green, "Bug": self.red, "Task": self.blue}.get(
            issue_type, self.magenta
        )


def _should_use_color() -> bool:
    return sys.stdout.isatty() and "NO_COLOR" not in os.environ


C: Colors = Colors.enabled() if _should_use_color() else Colors.disabled()


class Format(StrEnum):
    OPTION = "option"
    USER = "user"
    RESOLUTION = "resolution"
    STRING = "string"
    CHECKLIST = "checklist"
    DATE = "date"
    ISSUE_KEY = "issue_key"


def _format_date(raw: Any) -> str:
    """Render a Jira timestamp as a plain day, e.g. 2026-08-21T14:32:11.000+0100 -> 2026-08-21.

    Jira sends dates as ISO 8601 with a UTC offset. Anything unparseable is passed
    through unchanged rather than swallowed, so odd values stay visible.
    """
    try:
        return datetime.fromisoformat(str(raw)).date().isoformat()
    except ValueError:
        return str(raw)


# Dispatch tables for _format_custom_value. Adding a new format type means
# adding entries here rather than new branches.
_DICT_KEY: dict[str, str] = {
    Format.OPTION: "value",
    Format.USER: "displayName",
    Format.RESOLUTION: "name",
    Format.ISSUE_KEY: "key",
}
_NULL_DISPLAY: dict[str, str] = {
    Format.USER: "Unassigned",
    Format.RESOLUTION: "Unresolved",
}
_VALUE_TRANSFORM: dict[str, Callable[[Any], str]] = {
    Format.DATE: _format_date,
}


def _format_custom_value(raw: Any, fmt: str) -> str:
    if raw is None:
        return _NULL_DISPLAY.get(fmt, "None")
    if isinstance(raw, dict) and fmt in _DICT_KEY:
        return str(raw.get(_DICT_KEY[fmt], str(raw)))
    transform = _VALUE_TRANSFORM.get(fmt)
    if transform:
        return transform(raw)
    return str(raw)


def issue_type_badge(issue_type: str) -> str:
    if issue_type.lower().replace("-", "").replace(" ", "") == "subtask":
        return "SUB"
    return issue_type[0].upper()


def format_issue(
    issue: dict[str, Any],
    custom_fields: CustomFieldsConfig | None = None,
    epic_field: str | None = None,
    epic_name: str | None = None,
    colors: Colors = C,
) -> str:
    key = issue["key"]
    fields = issue["fields"]
    summary = fields["summary"]
    status = fields["status"]["name"]
    assignee = fields.get("assignee")
    assignee_name = assignee["displayName"] if assignee else "Unassigned"
    reporter = fields["reporter"]["displayName"]
    description = fields.get("description") or "No description"
    fix_versions = fields.get("fixVersions", [])
    fix_version_str = ", ".join(v["name"] for v in fix_versions) if fix_versions else "None"
    resolution = fields.get("resolution")
    resolution_str = resolution["name"] if resolution else "Unresolved"

    lines = [
        f"{colors.bold}{key}: {summary}{colors.reset}",
        f"{colors.cyan}Status:{colors.reset}      {status}",
        f"{colors.cyan}Resolution:{colors.reset}  {resolution_str}",
        f"{colors.cyan}Assignee:{colors.reset}    {assignee_name}",
        f"{colors.cyan}Reporter:{colors.reset}    {reporter}",
        f"{colors.cyan}Fix Version:{colors.reset} {fix_version_str}",
    ]

    if epic_field:
        epic_key = fields.get(epic_field)
        if epic_key:
            epic_str = f"{epic_key} \u2014 {epic_name}" if epic_name else epic_key
            lines.append(f"{colors.cyan}Epic:{colors.reset}        {epic_str}")

    parent = fields.get("parent")
    if parent:
        parent_summary = parent["fields"]["summary"]
        lines.append(
            f"{colors.cyan}Parent:{colors.reset}      "
            f"{parent['key']} \u2014 {parent_summary}"
        )

    if custom_fields:
        for label, cfg in custom_fields.get("metadata", {}).items():
            raw = fields.get(cfg["field"])
            value = _format_custom_value(raw, cfg.get("format", "string"))
            lines.append(f"{colors.cyan}{label}:{colors.reset} {value}")

    issuelinks = fields.get("issuelinks", [])
    if issuelinks:
        lines.append("")
        lines.append(f"{colors.bold}Links:{colors.reset}")
        for link in issuelinks:
            if "outwardIssue" in link:
                direction = link["type"]["outward"]
                linked = link["outwardIssue"]
            else:
                direction = link["type"]["inward"]
                linked = link["inwardIssue"]
            lkey = linked["key"]
            lsummary = linked["fields"]["summary"]
            lstatus = linked["fields"]["status"]["name"]
            ltype = linked["fields"]["issuetype"]["name"]
            badge = f"{colors.issue_type(ltype)}[{issue_type_badge(ltype)}]{colors.reset}"
            lines.append(f"  {direction} {badge} {lkey} ({lstatus}) {lsummary}")

    lines.append("")
    lines.append(description)

    comments = fields.get("comment", {}).get("comments", [])
    if comments:
        last_3 = comments[-3:]
        lines.append("")
        lines.append(f"{colors.bold}Comments ({len(last_3)}):{colors.reset}")
        for comment in last_3:
            author = comment["author"]["displayName"]
            body = comment["body"]
            lines.append(f"  {colors.green}{author}:{colors.reset} {body}")

    if custom_fields:
        for label, cfg in custom_fields.get("sections", {}).items():
            raw = fields.get(cfg["field"])
            if raw is None:
                continue
            fmt = cfg.get("format", "string")
            if fmt == "checklist":
                value = _format_checklist(raw, colors=colors)
            else:
                value = str(raw)
            lines.append("")
            lines.append(f"{colors.bold}{label}:{colors.reset}")
            lines.append(value)

    return "\n".join(lines)


def _format_checklist(raw: Any, colors: Colors = C) -> str:
    if not raw:
        return "No items"
    items: list[str] = []
    for entry in raw:
        matches = re.findall(
            r"value=(.*?), rank=\d+, status=Status\([^)]*name=(\w[\w ]*)",
            entry,
        )
        for value, status in matches:
            if status == "DONE":
                marker = f"{colors.green}[DONE]{colors.reset}"
            else:
                marker = f"{colors.yellow}[{status}]{colors.reset}"
            items.append(f"  {marker} {value}")
    return "\n".join(items) if items else "No items"


def format_issue_table(
    data: dict[str, Any],
    extra_fields: list[FieldSpec] | None = None,
    colors: Colors = C,
) -> str:
    issues = data["issues"]
    if not issues:
        return "No issues found"

    rows = []
    for issue in issues:
        key = issue["key"]
        summary = issue["fields"]["summary"]
        status = issue["fields"]["status"]["name"]
        extras = []
        if extra_fields:
            for _label, field_id, fmt in extra_fields:
                raw = issue["fields"].get(field_id)
                extras.append(_format_custom_value(raw, fmt))
        rows.append((key, summary, status, extras))

    key_width = max(len(r[0]) for r in rows)
    status_width = max(len(r[2]) for r in rows)
    extra_widths = []
    if extra_fields:
        for i, (_label, _fid, _fmt) in enumerate(extra_fields):
            extra_widths.append(max(len(r[3][i]) for r in rows))

    lines = []
    for key, summary, status, extras in rows:
        line = f"{colors.cyan}{key:<{key_width}}{colors.reset}  {summary}  {colors.yellow}{status:<{status_width}}{colors.reset}"
        for i, val in enumerate(extras):
            line += f"  {val:<{extra_widths[i]}}"
        lines.append(line)
    return "\n".join(lines)


def format_release(data: dict[str, Any], colors: Colors = C) -> str:
    issues = data["issues"]
    if not issues:
        return "No issues found"
    lines = []
    for issue in issues:
        key = issue["key"]
        summary = issue["fields"]["summary"]
        lines.append(f"{colors.cyan}[{key}]{colors.reset} {summary}")
    return "\n".join(lines)


class JiraError(Exception):
    pass


def create_session(token: str) -> requests.Session:
    session = requests.Session()
    session.trust_env = False  # prevent requests from applying .netrc Basic auth
    session.headers["Authorization"] = f"Bearer {token}"
    session.headers["Content-Type"] = "application/json"
    return session


def _handle_error(resp: requests.Response) -> None:
    msg = resp.text
    try:
        body = resp.json()
    except requests.JSONDecodeError:
        body = None
    if isinstance(body, dict):
        messages = body.get("errorMessages") or []
        if messages:
            msg = "; ".join(str(m) for m in messages)
    raise JiraError(f"HTTP {resp.status_code}: {msg}")


def api_get(
    session: requests.Session,
    base_url: str,
    path: str,
    params: dict[str, Any] | None = None,
) -> Any:
    resp = session.get(f"{base_url}/rest/api/2/{path}", params=params)
    if not resp.ok:
        _handle_error(resp)
    return resp.json()


def api_post(
    session: requests.Session,
    base_url: str,
    path: str,
    json: dict[str, Any] | None = None,
) -> Any:
    resp = session.post(f"{base_url}/rest/api/2/{path}", json=json)
    if not resp.ok:
        _handle_error(resp)
    if resp.content:
        return resp.json()
    return None


def api_put(
    session: requests.Session,
    base_url: str,
    path: str,
    json: dict[str, Any] | None = None,
) -> None:
    resp = session.put(f"{base_url}/rest/api/2/{path}", json=json)
    if not resp.ok:
        _handle_error(resp)


def cmd_edit(
    session: requests.Session,
    base_url: str,
    issue_key: str,
    summary: str | None = None,
) -> None:
    fields: dict[str, Any] = {}
    if summary is not None:
        fields["summary"] = summary
    if not fields:
        print("Error: Nothing to update", file=sys.stderr)
        raise SystemExit(1)
    api_put(session, base_url, f"issue/{issue_key}", json={"fields": fields})
    print(f"Updated {issue_key}")


def cmd_view(
    session: requests.Session,
    base_url: str,
    issue_keys: list[str],
    custom_fields: CustomFieldsConfig | None = None,
    epic_field: str | None = None,
) -> None:
    if len(issue_keys) == 1:
        issue_key = issue_keys[0]
        data = api_get(session, base_url, f"issue/{issue_key}")
        epic_name = None
        if epic_field:
            epic_key = data["fields"].get(epic_field)
            if epic_key:
                epic_data = api_get(session, base_url, f"issue/{epic_key}", params={"fields": "summary"})
                epic_name = epic_data["fields"]["summary"]
        print(format_issue(data, custom_fields=custom_fields, epic_field=epic_field, epic_name=epic_name))
        return

    jql = f"key in ({', '.join(issue_keys)})"
    data = api_get(
        session, base_url, "search",
        params={"jql": jql, "fields": "*all", "maxResults": len(issue_keys)},
    )
    by_key = {issue["key"]: issue for issue in data["issues"]}
    blocks: list[str] = []
    for key in issue_keys:
        issue = by_key.get(key)
        if issue is None:
            print(f"Error: Could not find {key}", file=sys.stderr)
            continue
        blocks.append(format_issue(issue, custom_fields=custom_fields, epic_field=epic_field))
    print("\n\n".join(blocks))


def build_list_jql(jql: str = "", mine: bool = False, status: str | None = None) -> str:
    parts: list[str] = []
    if mine:
        parts.append("assignee = currentUser()")
    if status:
        parts.append(f"status = '{status}'")
    if jql:
        parts.append(jql)
    if not parts:
        return "ORDER BY updated DESC"
    return " AND ".join(parts)


def cmd_list(
    session: requests.Session,
    base_url: str,
    project: str,
    jql: str = "",
    mine: bool = False,
    status: str | None = None,
    limit: int = 50,
    extra_fields: list[FieldSpec] | None = None,
) -> None:
    query = build_list_jql(jql=jql, mine=mine, status=status)
    query = normalize_jql(query, project)
    api_fields = "summary,status"
    if extra_fields:
        api_fields += "," + ",".join(fid for _label, fid, _fmt in extra_fields)
    data = api_get(
        session, base_url, "search",
        params={"jql": query, "maxResults": limit, "fields": api_fields},
    )
    print(format_issue_table(data, extra_fields=extra_fields))


def cmd_transition(
    session: requests.Session,
    base_url: str,
    issue_key: str,
    target_status: str | None = None,
) -> None:
    data = api_get(session, base_url, f"issue/{issue_key}/transitions")
    transitions = data["transitions"]
    available = [t["to"]["name"] for t in transitions]

    if target_status is None:
        print(f"Available transitions for {issue_key}:")
        for name in available:
            print(f"  {name}")
        return

    match = None
    for t in transitions:
        if t["to"]["name"].lower() == target_status.lower():
            match = t
            break

    if match is None:
        print(
            f"Error: Cannot transition {issue_key} to '{target_status}'\n"
            f"Available transitions: {', '.join(available)}",
            file=sys.stderr,
        )
        raise SystemExit(1)

    api_post(session, base_url, f"issue/{issue_key}/transitions", json={"transition": {"id": match["id"]}})
    print(f"Transitioned {issue_key} to {target_status}")


def cmd_release(
    session: requests.Session,
    base_url: str,
    project: str,
    version_name: str,
    extra_fields: list[FieldSpec] | None = None,
) -> None:
    jql = f'project = {project} AND fixVersion = "{version_name}" ORDER BY key ASC'
    api_fields = "summary,status"
    if extra_fields:
        api_fields += "," + ",".join(fid for _label, fid, _fmt in extra_fields)
    data = api_get(
        session, base_url, "search",
        params={"jql": jql, "maxResults": 200, "fields": api_fields},
    )
    if extra_fields:
        print(format_issue_table(data, extra_fields=extra_fields))
    else:
        print(format_release(data))


def cmd_releases(
    session: requests.Session,
    base_url: str,
    project: str,
    unreleased: bool = False,
    colors: Colors = C,
) -> None:
    versions = api_get(session, base_url, f"project/{project}/versions")
    if unreleased:
        versions = [v for v in versions if not v.get("released", False)]
    if not versions:
        print("No versions found")
        return
    name_width = max(len(v["name"]) for v in versions)
    lines = []
    for v in versions:
        name = v["name"]
        status = (
            f"{colors.green}Released{colors.reset}"
            if v.get("released")
            else f"{colors.yellow}Unreleased{colors.reset}"
        )
        date = v.get("releaseDate", "")
        lines.append(f"{colors.cyan}{name:<{name_width}}{colors.reset}  {status}  {date}")
    print("\n".join(lines))


DEFAULT_SERVER = "https://nhsd-jira.digital.nhs.uk"
DEFAULT_PROJECT = "MAV"


def cmd_init(config_dir: Path | str | None = None, netrc_path: Path | str | None = None) -> None:
    if config_dir is None:
        config_dir = Path.home() / ".config" / "nhse-jira"
    config_dir = Path(config_dir)
    if netrc_path is None:
        netrc_path = Path.home() / ".netrc"
    netrc_path = Path(netrc_path)

    config_file = config_dir / "config.yml"

    # If config already exists, ask before overwriting
    if config_file.exists():
        answer = input(f"Config already exists at {config_file}. Overwrite? [y/N] ")
        if answer.lower() != "y":
            return

    server = input(f"Jira server URL [{DEFAULT_SERVER}]: ").strip() or DEFAULT_SERVER
    hostname = urlparse(server).hostname
    if hostname is None:
        raise SystemExit(f"Invalid server URL (no hostname): {server}")

    pat_url = f"{server}/secure/ViewProfile.jspa?selectedTab=com.atlassian.pats.pats-plugin:jira-user-personal-access-tokens"
    print(f"\nCreate a Personal Access Token at:\n  {pat_url}\n")
    token = getpass.getpass("Paste your token: ")

    project = input(f"Default project [{DEFAULT_PROJECT}]: ").strip() or DEFAULT_PROJECT

    # Write config
    config_dir.mkdir(parents=True, exist_ok=True)
    config: dict[str, Any] = {"server": server, "project": project}
    if project.upper() == "MAV":
        config["epic_field"] = "customfield_10005"
        config["custom_fields"] = {
            "metadata": {
                "Clinical Severity": {"field": "customfield_37401", "format": "option"},
                "Clinical Safety": {"field": "customfield_10595", "format": "option"},
                "Checklist Progress": {"field": "customfield_22907", "format": "string"},
            },
            "sections": {
                "Clinical Summary": {"field": "customfield_37408", "format": "string"},
                "Test Summary": {"field": "customfield_37407", "format": "string"},
                "Smart Checklist": {"field": "customfield_22905", "format": "checklist"},
            },
        }
    config_file.write_text(yaml.safe_dump(config, sort_keys=False, default_flow_style=False))

    # Write netrc
    entry = f"machine {hostname} login _ password {token}\n"
    if netrc_path.exists():
        existing = netrc_path.read_text()
        if hostname not in existing:
            netrc_path.write_text(existing.rstrip("\n") + "\n" + entry)
    else:
        netrc_path.write_text(entry)
        netrc_path.chmod(0o600)

    print(f"\nConfig written to {config_file}")
    print(f"Token saved to {netrc_path}")


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(prog="nhse-jira", description="CLI for NHSE Jira")
    subparsers = parser.add_subparsers(dest="command", required=True)

    FMT = argparse.RawDescriptionHelpFormatter

    subparsers.add_parser("init", help="Set up config and authentication")

    view_parser = subparsers.add_parser("view", help="View issue details",
        formatter_class=FMT,
        epilog="examples:\n"
               "  nhse-jira view MAV-5902             view by full key\n"
               "  nhse-jira view 5902                 uses default project\n"
               "  nhse-jira view MAV-5902 MAV-5903    view several in one request")
    view_parser.add_argument("issues", nargs="+", help="Issue key(s) or number(s)")

    list_parser = subparsers.add_parser("list", help="Search issues with JQL",
        formatter_class=FMT,
        epilog="examples:\n"
               "  nhse-jira list --mine                       my open issues\n"
               "  nhse-jira list --mine --status \"In Progress\" my in-progress issues\n"
               "  nhse-jira list \"type = Bug\"                  JQL search\n"
               "  nhse-jira list --limit 10 \"priority = High\" limited results\n"
               "  nhse-jira list --mine --fields \"clinical safety,checklist progress\" with extra columns")
    list_parser.add_argument("jql", nargs="?", default="", help="JQL query")
    list_parser.add_argument("--mine", action="store_true", help="Only my issues")
    list_parser.add_argument("--status", help="Filter by status")
    list_parser.add_argument("--limit", type=int, default=50, help="Max results (default: 50)")
    list_parser.add_argument("--fields", default=None, help="Extra fields to show (comma-separated custom field labels)")

    trans_parser = subparsers.add_parser("transition", help="Transition an issue",
        formatter_class=FMT,
        epilog="examples:\n"
               "  nhse-jira transition 5902              list available transitions\n"
               "  nhse-jira transition 5902 \"In Progress\" move to In Progress\n"
               "  nhse-jira transition MAV-5902 Done     mark as done")
    trans_parser.add_argument("issue", help="Issue key or number")
    trans_parser.add_argument("status", nargs="?", default=None, help="Target status (omit to list available)")

    release_parser = subparsers.add_parser("release", help="List issues in a release",
        formatter_class=FMT,
        epilog="examples:\n"
               "  nhse-jira release v7.8.0\n"
               "  nhse-jira release v7.9.0 --fields \"clinical safety,checklist progress\" with assurance columns")
    release_parser.add_argument("version", help="Version name")
    release_parser.add_argument("--fields", default=None, help="Extra fields to show (comma-separated custom field labels)")

    releases_parser = subparsers.add_parser("releases", help="List project versions",
        formatter_class=FMT,
        epilog="examples:\n"
               "  nhse-jira releases              all versions\n"
               "  nhse-jira releases --unreleased  only unreleased")
    releases_parser.add_argument("--unreleased", action="store_true", help="Only unreleased versions")

    edit_parser = subparsers.add_parser("edit", help="Edit issue fields",
        formatter_class=FMT,
        epilog="examples:\n"
               "  nhse-jira edit MAV-5902 --title \"New title\"\n"
               "  nhse-jira edit 5902 --title \"New title\"      uses default project")
    edit_parser.add_argument("issue", help="Issue key or number")
    edit_parser.add_argument("--title", default=None, help="New summary/title for the issue")

    return parser


def main() -> None:
    parser = build_parser()
    args = parser.parse_args()

    if args.command == "init":
        cmd_init()
        return

    config = load_config()
    token = load_token(config["server"])
    session = create_session(token)
    base_url = config["server"]
    project = config["project"]

    try:
        match args.command:
            case "view":
                issue_keys = [normalize_key(k, project) for k in args.issues]
                cmd_view(session, base_url, issue_keys, custom_fields=config.get("custom_fields"), epic_field=config.get("epic_field"))
            case "list":
                extra = resolve_fields(args.fields.split(",") if args.fields else None, config.get("custom_fields", {}), epic_field=config.get("epic_field"))
                cmd_list(session, base_url, project, jql=args.jql, mine=args.mine, status=args.status, limit=args.limit, extra_fields=extra or None)
            case "transition":
                issue_key = normalize_key(args.issue, project)
                cmd_transition(session, base_url, issue_key, args.status)
            case "release":
                extra = resolve_fields(args.fields.split(",") if args.fields else None, config.get("custom_fields", {}), epic_field=config.get("epic_field"))
                cmd_release(session, base_url, project, args.version, extra_fields=extra or None)
            case "releases":
                cmd_releases(session, base_url, project, unreleased=args.unreleased)
            case "edit":
                issue_key = normalize_key(args.issue, project)
                cmd_edit(session, base_url, issue_key, summary=args.title)
    except JiraError as e:
        print(f"Error: {e}", file=sys.stderr)
        raise SystemExit(1) from e


if __name__ == "__main__":
    main()
